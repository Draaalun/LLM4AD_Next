# ============================================================
# LLM4AD 任务执行容器镜像
# ============================================================

# ---------- 基础镜像 ----------
FROM python:3.12-bookworm

# 禁用 Python 输出缓冲，保证日志实时输出
ENV PYTHONUNBUFFERED=1

# ---------- 安装 C++ 和 Java 编译环境 ----------
ARG APT_MIRROR=""
RUN if [ -n "$APT_MIRROR" ]; then \
      sed -i "s@deb.debian.org@${APT_MIRROR}@g" /etc/apt/sources.list.d/debian.sources && \
      sed -i "s@security.debian.org@${APT_MIRROR}@g" /etc/apt/sources.list.d/debian.sources; \
    fi && \
    apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    ninja-build \
    pkg-config \
    libeigen3-dev \
    openjdk-17-jdk-headless \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
ENV PATH="$JAVA_HOME/bin:$PATH"

# ---------- 安装 uv 包管理器 ----------
COPY --from=ghcr.io/astral-sh/uv:0.9.26 /uv /uvx /bin/

# 预编译字节码，加快启动速度
ENV UV_COMPILE_BYTECODE=1
# 使用 copy 模式安装依赖，避免硬链接问题
ENV UV_LINK_MODE=copy

# ---------- 工作目录 ----------
WORKDIR /app/backend/

# 将虚拟环境加入 PATH
ENV PATH="/app/backend/.venv/bin:$PATH"

# ---------- 安装依赖（不含工作区包，利用 Docker 层缓存）----------
ARG UV_INDEX_URL
COPY src/backend/uv.lock uv.lock
RUN --mount=type=cache,id=uv-task-runner,target=/root/.cache/uv \
    --mount=type=bind,source=src/backend/pyproject.toml,target=pyproject.toml \
    --mount=type=bind,source=pyproject.toml,target=/pyproject.toml \
    --mount=type=bind,source=README.md,target=/README.md \
    uv sync --no-install-workspace

# ---------- 复制应用代码 ----------
COPY ./src/backend/pyproject.toml /app/backend/
COPY ./src/backend/app/__init__.py        /app/backend/app/__init__.py
COPY ./src/backend/app/tasks/container_runner.py             /app/backend/app/tasks/container_runner.py
COPY ./src/backend/app/tasks/chat_tune_runner.py             /app/backend/app/tasks/chat_tune_runner.py
COPY ./src/backend/app/tasks/task_config_crypto.py           /app/backend/app/tasks/task_config_crypto.py

# 复制 llm4ad 核心库及根项目配置
COPY ./src/llm4ad             /src/llm4ad
COPY ./examples               /examples
COPY ./pyproject.toml     /pyproject.toml
COPY ./README.md          /README.md

# ---------- 安装工作区包 ----------
RUN --mount=type=cache,id=uv-task-runner,target=/root/.cache/uv \
    --mount=type=bind,source=src/backend/pyproject.toml,target=pyproject.toml \
    uv sync

# ---------- 创建非 root 用户，提升安全性,git 目录权限问题，暂时使用root ----------
# RUN useradd --create-home --shell /bin/bash taskrunner
# USER taskrunner

# ---------- 启动任务执行器 ----------
CMD ["python", "app/tasks/container_runner.py"]