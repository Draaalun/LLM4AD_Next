<mjml>
  <mj-head>
    <mj-title>{{ project_name }} - New Account</mj-title>
    <mj-preview>Your {{ project_name }} account has been created. Here are your login credentials.</mj-preview>
    <mj-attributes>
      <mj-all font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif" />
      <mj-text font-size="15px" color="#334155" line-height="1.6" padding="0" />
      <mj-section background-color="#ffffff" padding="0" />
    </mj-attributes>
  </mj-head>

  <mj-body background-color="#f8fafc" width="600px">

    <!-- Brand Accent Bar -->
    <mj-section background-color="#111827" padding="0">
      <mj-column>
        <mj-divider border-width="4px" border-color="#111827" padding="0" />
      </mj-column>
    </mj-section>

    <!-- Header -->
    <mj-section padding="36px 40px 28px 40px" border-left="1px solid #e2e8f0" border-right="1px solid #e2e8f0">
      <mj-column>
        <mj-text font-size="22px" font-weight="700" color="#0f172a" line-height="1.3" letter-spacing="-0.2px">
          {{ project_name }}
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Divider -->
    <mj-section padding="0 40px" border-left="1px solid #e2e8f0" border-right="1px solid #e2e8f0">
      <mj-column>
        <mj-divider border-width="1px" border-color="#e2e8f0" padding="0" />
      </mj-column>
    </mj-section>

    <!-- Title & Greeting -->
    <mj-section padding="36px 40px 0 40px" border-left="1px solid #e2e8f0" border-right="1px solid #e2e8f0">
      <mj-column>
        <mj-text font-size="20px" font-weight="600" color="#0f172a" line-height="1.4" padding-bottom="20px">
          Welcome to {{ project_name }}
        </mj-text>
        <mj-text padding-bottom="8px">
          Hello {{ username }},
        </mj-text>
        <mj-text padding-bottom="32px">
          Your account has been successfully created. Below are your login credentials. Please keep this information secure and change your password after your first login.
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Credentials Box -->
    <mj-section padding="0 40px 28px 40px" border-left="1px solid #e2e8f0" border-right="1px solid #e2e8f0">
      <mj-column background-color="#f8fafc" border="1px solid #e2e8f0" border-radius="8px" padding="24px 28px">
        <mj-text font-size="11px" font-weight="700" color="#64748b" text-transform="uppercase" letter-spacing="1px" padding-bottom="4px">
          Email
        </mj-text>
        <mj-text font-size="15px" font-weight="600" color="#0f172a" padding-bottom="18px">
          {{ email }}
        </mj-text>
        <mj-text font-size="11px" font-weight="700" color="#64748b" text-transform="uppercase" letter-spacing="1px" padding-bottom="4px">
          Username
        </mj-text>
        <mj-text font-size="15px" font-weight="600" color="#0f172a" padding-bottom="18px">
          {{ username }}
        </mj-text>
        <mj-text font-size="11px" font-weight="700" color="#64748b" text-transform="uppercase" letter-spacing="1px" padding-bottom="4px">
          Temporary Password
        </mj-text>
        <mj-text font-family="'Courier New', Courier, monospace" font-size="16px" font-weight="700" color="#1e40af" letter-spacing="0.5px">
          {{ password }}
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- CTA Button & Fallback Link -->
    <mj-section padding="0 40px 32px 40px" border-left="1px solid #e2e8f0" border-right="1px solid #e2e8f0">
      <mj-column>
        <mj-button align="center" background-color="#111827" border-radius="6px" color="#ffffff" font-size="15px" font-weight="600" inner-padding="14px 36px" href="{{ link }}" padding-bottom="20px" letter-spacing="0.2px">
          Sign In to Your Account
        </mj-button>
        <mj-text font-size="13px" color="#64748b" line-height="1.6">
          If the button above does not work, copy and paste the following URL into your browser:
          <br />
          <a href="{{ link }}" style="color: #1e40af; text-decoration: underline; word-break: break-all;">{{ link }}</a>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Security Notice -->
    <mj-section padding="0 40px 40px 40px" border-left="1px solid #e2e8f0" border-right="1px solid #e2e8f0">
      <mj-column border-top="1px solid #e2e8f0" padding-top="24px">
        <mj-text font-size="13px" color="#64748b" line-height="1.6">
          For security purposes, we strongly recommend changing your password immediately after signing in. If you did not expect to receive this email, please contact your system administrator.
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Footer -->
    <mj-section padding="24px 40px" background-color="#f1f5f9" border-top="1px solid #e2e8f0" border-left="1px solid #e2e8f0" border-right="1px solid #e2e8f0" border-bottom="1px solid #e2e8f0" border-radius="0 0 8px 8px">
      <mj-column>
        <mj-text align="center" font-size="12px" color="#94a3b8" line-height="1.6">
          This is an automated message from {{ project_name }}. Please do not reply directly to this email.
          <br />
          &copy; {{ project_name }}. All rights reserved.
        </mj-text>
      </mj-column>
    </mj-section>

  </mj-body>
</mjml>
