<mjml>
  <mj-head>
    <mj-title>{{ project_name }} - Email Verification</mj-title>
    <mj-preview>Your {{ project_name }} verification code is {{ code }}. It expires in {{ valid_minutes }} minutes.</mj-preview>
    <mj-attributes>
      <mj-all font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif" />
      <mj-text font-size="15px" color="#334155" line-height="1.6" padding="0" />
      <mj-section background-color="#ffffff" padding="0" />
    </mj-attributes>
    <mj-style>
      @media only screen and (max-width: 640px) {
        .code-text div { font-size: 32px !important; letter-spacing: 6px !important; }
      }
    </mj-style>
  </mj-head>

  <mj-body background-color="#f8fafc" width="600px">

    <!-- Brand Accent Bar -->
    <mj-section background-color="#111827" padding="0">
      <mj-column>
        <mj-divider border-width="4px" border-color="#111827" padding="0" />
      </mj-column>
    </mj-section>

    <!-- Header -->
    <mj-section padding="36px 40px 28px 40px" border-left="1px solid #e2e8f0" border-right="1px solid #e2e8f0">
      <mj-column>
        <mj-text font-size="22px" font-weight="700" color="#0f172a" line-height="1.3" letter-spacing="-0.2px">
          {{ project_name }}
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Divider -->
    <mj-section padding="0 40px" border-left="1px solid #e2e8f0" border-right="1px solid #e2e8f0">
      <mj-column>
        <mj-divider border-width="1px" border-color="#e2e8f0" padding="0" />
      </mj-column>
    </mj-section>

    <!-- Title & Description -->
    <mj-section padding="36px 40px 0 40px" border-left="1px solid #e2e8f0" border-right="1px solid #e2e8f0">
      <mj-column>
        <mj-text font-size="20px" font-weight="600" color="#0f172a" line-height="1.4" padding-bottom="20px">
          Email Verification
        </mj-text>
        <mj-text padding-bottom="8px">
          Hello,
        </mj-text>
        <mj-text padding-bottom="32px">
          We received a registration request for the email address <strong style="color: #0f172a;">{{ email }}</strong>. Please use the verification code below to complete your registration.
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Verification Code Box -->
    <mj-section padding="0 40px 16px 40px" border-left="1px solid #e2e8f0" border-right="1px solid #e2e8f0">
      <mj-column background-color="#f8fafc" border="1px solid #e2e8f0" border-radius="10px" padding="28px 48px">
        <mj-text align="center" font-size="11px" font-weight="700" color="#64748b" text-transform="uppercase" letter-spacing="1.5px" padding-bottom="14px">
          Verification Code
        </mj-text>
        <mj-text align="center" css-class="code-text" font-family="'Courier New', Courier, monospace" font-size="40px" font-weight="700" color="#1e40af" letter-spacing="10px">
          {{ code }}
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Expiration Notice -->
    <mj-section padding="0 40px 32px 40px" border-left="1px solid #e2e8f0" border-right="1px solid #e2e8f0">
      <mj-column>
        <mj-raw>
          <table role="presentation" cellpadding="0" cellspacing="0" border="0" align="center">
            <tr>
              <td style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; font-size: 13px; color: #92400e; background-color: #fffbeb; border: 1px solid #fde68a; border-radius: 6px; padding: 10px 20px; line-height: 1.5;">
                This code will expire in <strong>{{ valid_minutes }} minutes</strong>.
              </td>
            </tr>
          </table>
        </mj-raw>
      </mj-column>
    </mj-section>

    <!-- Security Notice -->
    <mj-section padding="0 40px 40px 40px" border-left="1px solid #e2e8f0" border-right="1px solid #e2e8f0">
      <mj-column border-top="1px solid #e2e8f0" padding-top="24px">
        <mj-text font-size="13px" color="#64748b" line-height="1.6">
          If you did not initiate this request, please ignore this email. No account will be created without completing the verification process.
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Footer -->
    <mj-section padding="24px 40px" background-color="#f1f5f9" border-top="1px solid #e2e8f0" border-left="1px solid #e2e8f0" border-right="1px solid #e2e8f0" border-bottom="1px solid #e2e8f0" border-radius="0 0 8px 8px">
      <mj-column>
        <mj-text align="center" font-size="12px" color="#94a3b8" line-height="1.6">
          This is an automated message from {{ project_name }}. Please do not reply directly to this email.
          <br />
          &copy; {{ project_name }}. All rights reserved.
        </mj-text>
      </mj-column>
    </mj-section>

  </mj-body>
</mjml>
