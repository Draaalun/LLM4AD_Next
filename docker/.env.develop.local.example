# 本地开发环境示例配置文件，根据实际情况修改。部署基础服务，前后端本地启动。
# 前端地址，用于生成邮件中的链接等，必需是公网可访问的地址
FRONTEND_HOST=http://localhost:5173

# 环境名： local-本地调试, staging, production-生产
ENVIRONMENT=local

# 项目唯一名称，必需小写
PROJECT_NAME=llm4ad-web

# 可通过python生成 `python -c "import secrets; print(secrets.token_urlsafe(32))"`
SECRET_KEY=xxxx

# 供应商凭据加密专用密钥（与 SECRET_KEY 解耦）。务必显式设置且设置后不要再变更：
# 留空会回退到 SECRET_KEY 派生，而 SECRET_KEY 一旦轮换或在裸 python 本地运行时
# 取随机默认值，会导致已加密的供应商凭据无法解密（重启后凭据静默丢失）。
# 生成方式同上：`python -c "import secrets; print(secrets.token_urlsafe(32))"`
PROVIDER_ENCRYPTION_KEY=xxxx

# 首个超级管理员账户
FIRST_SUPERUSER=xxxx@qq.com
FIRST_SUPERUSER_PASSWORD=xxxx

# ---------- SMTP (Email) ----------
# 邮件服务，开发使用`mailcatcher`拦截，生产请改为真实的邮件服务器配置
SMTP_HOST=localhost
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=info@example.com
SMTP_TLS=False
SMTP_SSL=False
SMTP_PORT=1025

# ---------- PostgreSQL ----------
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=xxxx

# ---------- Sentry (Optional) ----------
SENTRY_DSN=

# ---------- Docker Images ----------
DOCKER_IMAGE_BACKEND=backend
DOCKER_IMAGE_FRONTEND=frontend

# ---------- RustFS (Object Storage) ----------
RUSTFS_ACCESS_KEY=xxxx
RUSTFS_SECRET_KEY=xxxx
RUSTFS_ENDPOINT=http://localhost:9000

# ---------- Redis ----------
REDIS_PASSWORD=xxxx
REDIS_HOST=localhost
REDIS_PORT=6379

# ---------- Project Home ----------
# 本地调试HOST_PROJECT_HOME和DOCKER_PROJECT_HOME需要一致，部署时HOST_PROJECT_HOME可以是服务器上的任意目录，但必须确保该目录存在且有读写权限。
HOST_PROJECT_HOME=/data/project_home/
DOCKER_PROJECT_HOME=/data/project_home/

# ---------- Code Server Proxy ----------
# 开发: http://host.docker.internal:8000  部署: http://backend:8000
AUTH_BACKEND_URL=http://host.docker.internal:8000

# ---------- Ports ----------
FRONTEND_PORT=18041

VITE_CODE_SERVER_URL=/code_ide

# ---------- APT Mirror (Optional) ----------
# 配置 APT 镜像源加速容器构建，留空则使用默认源
# 例如: mirrors.aliyun.com
APT_MIRROR=
UV_INDEX_URL=

JINA_API_KEY=

# 是否跳过注册时邮箱验证，跳过后前端会自动填充验证码
SKIP_EMAIL_VERIFICATION=

# AI构建是否启用容器网络，本地调试使用false否则无法连接容器
CHAT_TUNE_CONTAINER_NETWORK=
